CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

EAT_SIGNING_KEY=change-this-to-a-long-random-secret
EAT_TTL_SECONDS=60
SETTLEMENT_WEBHOOK_SECRET=change-this-webhook-secret
SETTLEMENT_WEBHOOK_TOLERANCE_SECONDS=300

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

FX_RATE_URL=https://example.test/mock/ngn-cny
